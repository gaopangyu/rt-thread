# applications/environment — board environment (rtc / auto_mount / usb)

from building import *
import os

cwd = GetCurrentDir()
src = Glob('*.c')
CPPPATH = [cwd, os.path.join(cwd, '..')]

group = DefineGroup('ApplicationsEnvironment', src, depend = ['RT_USING_CUSTOM'], CPPPATH = CPPPATH)

Return('group')
